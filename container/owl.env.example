# Copy to container/owl.env (gitignored) and edit. Every variable is optional
# except where marked. Full reference: container/README.md.

# --- Power source (THE thing to adapt) ----------------------------------------
# synthetic  simulated watts — smoke tests only; every page says SIMULATED
# component  sum of per-component readers (see OWL_COMPONENT_READERS)
# tapo       Tapo P110 smart plug(s) on the LAN (GoS's own bench)
OWL_POWER_SOURCE=synthetic

# component source: readers to sum, comma-separated: rapl, nvidia, http
#OWL_COMPONENT_READERS=rapl,nvidia
# http reader: endpoint + component=path (JSON) or component=metric (Prometheus)
#OWL_POWER_URL=http://127.0.0.1:9100/metrics
#OWL_POWER_FIELDS=cpu=node_rapl_package_watts,dram=node_rapl_dram_watts,gpu=gpu_power_watts
#OWL_POWER_SCALE=1
#OWL_POWER_HEADERS=Authorization=Bearer xxx
# Free-text provenance stamped on every result (defaults are generated):
#OWL_METER_NAME=Provider component telemetry v0
#OWL_METER_SCOPE=Component-level: CPU package + DRAM + GPU board. PSU, fans, NIC, storage excluded.

# synthetic source tuning
#OWL_SYNTH_IDLE_W=60
#OWL_SYNTH_CPU_W=120

# tapo source (GoS bench only)
#TAPO_EMAIL=
#TAPO_PASSWORD=
#TAPO_P110_IP=

# --- Access ----------------------------------------------------------------------
# Lab tier (settings, batch runs, admin) is granted ONLY to loopback + these CIDRs.
# Default 172.16.0.0/12 = the Docker bridge, i.e. browsers on the host itself or
# through an SSH tunnel. Add your office IP if you publish the port publicly:
#OWL_LAB_CIDRS=172.16.0.0/12,203.0.113.10/32
# A reverse proxy in front (nginx/Caddy/LB) whose X-Real-IP header OWL should trust:
#OWL_TRUSTED_PROXIES=172.16.0.0/12
# Signs member magic links; set any long random string to keep sessions across restarts.
#OWL_AUTH_SECRET=

# --- Models + content pulled at start (all optional) ------------------------------
# LLM ladder tiers to pull (only those that fit this host are pulled): S,M,L,XL or all
OWL_LLM_TIERS=S
# Image models (HF repos, downloaded into the data volume)
#OWL_IMAGE_MODELS=sd-turbo
# Download the open-licence test videos (~1.3 GB) on start
OWL_FETCH_CONTENT=1

# --- Measurement hygiene ------------------------------------------------------------
# GoS1 pauses systemd timers during a run; a container cannot. Recorded as
# focus_mode "unavailable" on every result either way.
#OWL_FOCUS_MODE=off
