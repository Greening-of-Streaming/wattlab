.env
# test_content/ + results/ are symlinks to /srv/data/owl/ (4 TB disk, S24) —
# no trailing slash so the patterns also match the symlinks, not just dirs.
test_content
results
__pycache__/
*.pyc

# CR-001 member-list data — real GoS member emails, source CSVs, etc.
# Contains personal data, not for the repo. Only the example file is tracked.
data/*
!data/*.example.*

# RAG runtime data (vectors regenerable from corpus; corpus is source PDFs
# we don't want to bloat the repo with — and CR follow-up plans visitor
# uploads landing here). Both are symlinks to /srv/data/owl/ since S24 —
# no trailing slash so the patterns match the symlinks too.
.chroma
corpus

# Backup / scratch files left around by previous sessions.
*.bak
*.session*

# One-off OS install artifacts that landed in the working tree.
amdgpu-install_*.deb

# Sibling project (REM has its own repo at dom-robinson/stats; this is
# just a working copy here for cross-project context).
REM/
TRAINING_REM_5MIN.md
