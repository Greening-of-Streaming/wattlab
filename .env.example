# WattLab (OWL) environment — copy to .env at the repo root and fill in real values.
# .env is gitignored; never commit real credentials.

# Tapo cloud account email (P110 smart-plug API login)
TAPO_EMAIL=you@example.com

# Tapo cloud account password
TAPO_PASSWORD=changeme

# LAN IP of the Tapo P110 smart plug on the server's mains supply.
# With the CR-065 daisy-chain this is the INNER plug (closest to the server) —
# it measures the server alone and stays the primary/absolute-W meter.
TAPO_P110_IP=192.168.1.100

# Optional second P110 (CR-065): the OUTER plug of the daisy-chain
# (wall → outer → inner → server). It sees server + inner-plug self-draw;
# leave unset for exact single-meter behavior.
#TAPO_P110_IP_2=192.168.1.101

# Secret key for signing magic-link sign-in tokens (CR-001) — any long random string
OWL_AUTH_SECRET=replace-with-a-long-random-string

# Gmail address used to send magic-link sign-in emails (SMTP sender)
OWL_SMTP_USER=you@gmail.com

# Gmail app password (16 chars) for the sender account — not the account password
OWL_SMTP_PASSWORD=xxxxxxxxxxxxxxxx
