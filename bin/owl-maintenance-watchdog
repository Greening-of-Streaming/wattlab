#!/usr/bin/env bash
# owl-maintenance-watchdog — auto-lower the staging maintenance flag.
#
# CR-015. One-shot. Fires every minute via owl-maintenance-watchdog.timer.
#
# What this does:
#   1. If /tmp/owl-maintenance does not exist → nothing to do, exit 0.
#   2. Read max_idle_mins from settings.json (default 30 if missing).
#   3. If the flag's mtime is younger than max_idle_mins → operator is
#      around (the Lab-tier middleware in main.py touches the flag on
#      every request), exit 0.
#   4. Otherwise the flag has gone stale → run stage-off (without
#      --main, so the currently-checked-out branch is preserved).
#
# Companion to bin/stage-on / bin/stage-off — see CR-015 in
# CHANGE_REQUESTS.md and the `## owl-maintenance-watchdog` section
# in bin/README.md for context.

set -euo pipefail

FLAG="/tmp/owl-maintenance"
SETTINGS_FILE="/home/gos/wattlab/settings.json"
DEFAULT_IDLE_MINS=30
STAGE_OFF="/home/gos/wattlab/bin/stage-off"

# 1. No flag → nothing to do.
if [[ ! -f "$FLAG" ]]; then
  exit 0
fi

# 2. Read the threshold from settings.json. Tolerant of jq absence.
if command -v jq >/dev/null 2>&1; then
  idle_mins=$(jq -r '.max_idle_mins // empty' "$SETTINGS_FILE" 2>/dev/null || true)
fi
idle_mins=${idle_mins:-$DEFAULT_IDLE_MINS}

# Validate — if anything weird, fall back to default.
if ! [[ "$idle_mins" =~ ^[0-9]+$ ]] || [[ "$idle_mins" -le 0 ]]; then
  idle_mins=$DEFAULT_IDLE_MINS
fi

# 3. mtime check.
flag_age_s=$(( $(date +%s) - $(stat -c %Y "$FLAG") ))
threshold_s=$(( idle_mins * 60 ))

if [[ "$flag_age_s" -lt "$threshold_s" ]]; then
  # Operator is active — leave the flag alone.
  exit 0
fi

# 4. Stale → lower the flag. Stay on the current branch (no --main).
echo "owl-maintenance-watchdog: flag idle for ${flag_age_s}s (threshold ${threshold_s}s) — running stage-off"
exec "$STAGE_OFF"
