#!/usr/bin/env bash
# gpu-clock-sweep — find the lowest GPU SM clock that still holds the NVENC
# encode time (i.e. the energy-efficient regime before the CUDA decode+scale
# stage becomes the bottleneck).
#
# WHY: NVENC is fixed-function; the CUDA cores only decode+scale and then wait
# on the encoder. GPU Boost over-clocks the cores into a wasteful zone (more
# watts, identical time). This sweep locks the clock at descending bins and
# measures time + power so we can pin the box at the efficient knee, making
# energy measurements reproducible across reboots/seasons (S54 investigation).
#
# Requires root (nvidia-smi -lgc/-rgc/-pm). Run: sudo bin/gpu-clock-sweep
# Safe: always releases the clock lock on exit (even on Ctrl-C / error).
set -uo pipefail

FF=/usr/local/bin/ffmpeg-master
SRC=/home/gos/wattlab/test_content/meridian_120s.mp4
OUT=/tmp/gpu_clock_sweep_out.mp4
# descending target clocks (MHz) — driver snaps to nearest supported bin
CLOCKS=(2880 2580 2280 1980 1680 1380 1080 780 480 330)
TOL=1.05            # "holds time" = within 5% of the fastest run's time
MEAS_RUNS=2         # measured encodes per clock (after 1 warm-up)

if [[ $EUID -ne 0 ]]; then echo "Must run as root (needs nvidia-smi -lgc). Try: sudo $0"; exit 1; fi
[[ -f "$SRC" ]] || { echo "source missing: $SRC"; exit 1; }

cleanup() { nvidia-smi -rgc >/dev/null 2>&1; rm -f "$OUT" /tmp/_sweep_smp.csv; echo; echo "clocks released."; }
trap cleanup EXIT INT TERM

nvidia-smi -pm 1 >/dev/null 2>&1

encode_once() {  # echoes "time_s mean_power_W mean_sm_MHz"
  nvidia-smi --query-gpu=power.draw,clocks.sm --format=csv,noheader -lms 200 >/tmp/_sweep_smp.csv 2>/dev/null & local sp=$!
  sleep 0.4
  local t0 t1; t0=$(date +%s.%N)
  nice -n -5 "$FF" -y -hwaccel cuda -hwaccel_output_format cuda -i "$SRC" \
    -vf scale_cuda=-2:1080 -c:v h264_nvenc -b:v 4000k -g 120 -profile:v high \
    -bf 2 -rc cbr -c:a aac -b:a 128k "$OUT" -progress pipe:1 -nostats >/dev/null 2>&1
  t1=$(date +%s.%N)
  sleep 0.4; kill $sp 2>/dev/null; wait $sp 2>/dev/null
  awk -F', ' -v t="$(echo "$t1 - $t0" | bc)" '
    {gsub(/ W| MHz/,"",$1); gsub(/ MHz/,"",$2)}
    $2>150 {p+=$1; s+=$2; n++}
    END{ if(n) printf "%.2f %.1f %.0f\n", t, p/n, s/n; else print "0 0 0" }' /tmp/_sweep_smp.csv
}

printf "%-12s %-12s %-10s %-10s %-12s %s\n" "target(MHz)" "actual(MHz)" "time(s)" "power(W)" "energy(Wh)" "Wh/min"
declare -a R_CLK R_T R_E
best_t=99999
for c in "${CLOCKS[@]}"; do
  nvidia-smi -lgc "${c},${c}" >/dev/null 2>&1
  sleep 1
  encode_once >/dev/null    # warm-up (discarded)
  tsum=0; psum=0; ssum=0
  for ((r=0; r<MEAS_RUNS; r++)); do
    read -r tt pp ss < <(encode_once)
    tsum=$(echo "$tsum + $tt" | bc); psum=$(echo "$psum + $pp" | bc); ssum=$(echo "$ssum + $ss" | bc)
  done
  t=$(echo "scale=2; $tsum / $MEAS_RUNS" | bc)
  p=$(echo "scale=1; $psum / $MEAS_RUNS" | bc)
  s=$(echo "scale=0; $ssum / $MEAS_RUNS" | bc)
  e=$(echo "scale=4; $p * $t / 3600" | bc)
  whmin=$(echo "scale=4; $p * 60 / 3600" | bc)
  printf "%-12s %-12s %-10s %-10s %-12s %s\n" "$c" "$s" "$t" "$p" "$e" "$whmin"
  R_CLK+=("$c"); R_T+=("$t"); R_E+=("$e")
  awk "BEGIN{exit !($t < $best_t)}" && best_t=$t
done

# pick lowest clock whose time stays within TOL of the fastest
thr=$(echo "$best_t * $TOL" | bc)
knee=""
for i in "${!R_CLK[@]}"; do
  if awk "BEGIN{exit !(${R_T[$i]} <= $thr)}"; then knee="${R_CLK[$i]}"; knee_t="${R_T[$i]}"; knee_e="${R_E[$i]}"; fi
done
echo
echo "fastest time observed: ${best_t}s ; hold threshold (<= ${TOL}x): ${thr}s"
if [[ -n "$knee" ]]; then
  echo ">>> lowest clock that still holds time: ${knee} MHz  (time ${knee_t}s, energy ${knee_e} Wh)"
  echo ">>> to pin permanently: sudo nvidia-smi -pm 1 && sudo nvidia-smi -lgc ${knee},${knee}"
else
  echo ">>> no clock held the time within tolerance — widen CLOCKS/TOL."
fi
