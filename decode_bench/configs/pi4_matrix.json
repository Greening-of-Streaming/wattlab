    {"name": "bbb_av1_sw_full",  "cmd": "ffmpeg -nostdin -stream_loop -1 -i /dev/shm/decode/bbb_av1_6min.mp4 -an -f null - ",  "stop_cmd": "pkill -f ffmpeg"},
    {"name": "bbb_h264_sw_rt",   "cmd": "ffmpeg -nostdin -re -i /dev/shm/decode/bbb_h264_6min.mp4 -an -f null - ", "stop_cmd": "pkill -f ffmpeg", "window_s": 150},
    {"name": "bbb_h264_hw_rt",   "cmd": "ffmpeg -nostdin -re -c:v h264_v4l2m2m -i /dev/shm/decode/bbb_h264_6min.mp4 -an -f null - ", "stop_cmd": "pkill -f ffmpeg", "window_s": 150}
